PORT=3000
DOWNLOAD_DIR=./downloads
# Optional: set a custom yt-dlp executable path.
# YT_DLP_COMMAND=yt-dlp
# Node is included in the Docker image and handles YouTube's JavaScript challenges.
YT_DLP_JS_RUNTIME=node:/usr/local/bin/node
# Optional: path to a Netscape-format YouTube cookies file inside the container.
# YT_DLP_COOKIES=/app/secrets/youtube-cookies.txt
